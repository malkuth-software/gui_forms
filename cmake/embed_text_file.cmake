# Embeds one text file as C++ arrays (the code-zoom demonstrator's source,
# demo/code_zoom/code_zoom.cpp; the automation help's documentation pages,
# src/controls/automation/help/automation_help.cpp): run as
#   cmake -DSOURCE=<file> -DNAME=<path shown> -DOUTPUT=<file.inc> -P embed_text_file.cmake
# OUTPUT defines `embedded_source_path`, NAME as a string, and
# `embedded_source_bytes`, the file's bytes followed by a zero (so the
# array is never empty; the text's length is its size less one). The
# includer chooses the namespace.
if(NOT DEFINED SOURCE OR NOT DEFINED NAME OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "embed_text_file.cmake needs SOURCE, NAME and OUTPUT")
endif()
file(READ "${SOURCE}" _gf_hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _gf_bytes "${_gf_hex}")
string(REPLACE "\"" "\\\"" _gf_name "${NAME}")
file(WRITE "${OUTPUT}.tmp"
    "// Generated by cmake/embed_text_file.cmake from ${NAME}; do not edit.\n"
    "constexpr char embedded_source_path[] = \"${_gf_name}\";\n"
    "constexpr unsigned char embedded_source_bytes[] = {${_gf_bytes}0x00};\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
