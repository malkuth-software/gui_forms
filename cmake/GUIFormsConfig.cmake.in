@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(stx_zlib CONFIG)
find_dependency(stx_png CONFIG)
find_dependency(stx_conv CONFIG)
find_dependency(stx_rtf2md CONFIG)
# The stx package's red/blue swap kernel, installed beside the static Core and
# Controls that link it (CMakeLists.txt), under the name GUIFormsTargets uses.
if(NOT TARGET stx_skia::swizzle)
    add_library(stx_skia::swizzle STATIC IMPORTED)
    set_target_properties(stx_skia::swizzle PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@GUI_FORMS_SWIZZLE_ARCHIVE_NAME@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsTargets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsApplicationTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsApplicationTargets.cmake")
endif()
# The form compiler (stage FD) and gui_forms_add_form(), which runs it.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsFormCompilerTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsFormCompilerTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsForms.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsThemes.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsAudioTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    if("@GUI_FORMS_AUDIO_VORBIS_BACKEND@" STREQUAL "stx")
        find_dependency(stx_vorbis CONFIG)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsAudioTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsTextMasksTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsTextMasksTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsTextStackTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsTextStackTargets.cmake")
endif()
# The Gallery model (GUI_FORMS_INSTALL_GALLERY_MODEL): a static library that
# names no GUI.Forms library; link it with Application (a program) or Controls
# (a headless test).
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsGalleryModelTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsGalleryModelTargets.cmake")
endif()
# The C ABI (cmake/CAbi.cmake): a shared library with a C header. It links the
# Application library (one engine per process), so it is installed only with it.
# Its conformance kit, GUIForms::CAbiConformance, is a static library that
# links Threads (found above).
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GUIFormsCAbiTargets.cmake" AND TARGET GUIForms::Application)
    include("${CMAKE_CURRENT_LIST_DIR}/GUIFormsCAbiTargets.cmake")
endif()

# The localizable-literal Clang plugin, installed with the SDK when it was
# built (cmake/LocalizablePlugin.cmake): a consumer compiling with Clang 22 is
# compiled with it, so the literals it passes to localizable properties are
# recorded for gui_forms::localizable_literals(). Set
# GUI_FORMS_LOCALIZABLE_LITERALS OFF before find_package to compile without it.
option(GUI_FORMS_LOCALIZABLE_LITERALS "Compile with the GUI.Forms localizable-literal Clang plugin" ON)
set(_gui_forms_plugin
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/gui_forms/gui_forms_localizable@CMAKE_SHARED_MODULE_SUFFIX@")
# clang-cl takes the plugin's driver options behind /clang:.
set(_gui_forms_driver "")
if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(_gui_forms_driver "/clang:")
endif()
set(GUIForms_EFFECTS_VERIFIED FALSE)
if(GUI_FORMS_LOCALIZABLE_LITERALS AND EXISTS "${_gui_forms_plugin}" AND TARGET GUIForms::Core)
    set(_gui_forms_clang22
        "$<AND:$<COMPILE_LANGUAGE:CXX,OBJCXX>,$<CXX_COMPILER_ID:Clang>,$<VERSION_GREATER_EQUAL:$<CXX_COMPILER_VERSION>,22>,$<VERSION_LESS:$<CXX_COMPILER_VERSION>,23>>")
    set_property(TARGET GUIForms::Core APPEND PROPERTY INTERFACE_COMPILE_OPTIONS
        "$<${_gui_forms_clang22}:${_gui_forms_driver}-fplugin=${_gui_forms_plugin}>"
        "$<${_gui_forms_clang22}:${_gui_forms_driver}-fplugin-arg-gui_forms_localizable-root=${CMAKE_SOURCE_DIR}>")
    unset(_gui_forms_clang22)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 22
       AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 23)
        set(GUIForms_EFFECTS_VERIFIED TRUE)
    endif()
endif()
unset(_gui_forms_driver)
unset(_gui_forms_plugin)

# A consumer's files that register effect programs
# (docs/user/effect-verification.md). With Clang 22 and the plugin they are
# compiled with its effect pass like every other source of the target; plain
# cl.exe is refused (C-12: an MSVC project compiles them with clang-cl), and
# any other compiler builds them unverified, with a warning naming them.
function(gui_forms_verify_effects target)
    cmake_parse_arguments(PARSE_ARGV 1 _gf "" "" "SOURCES")
    string(JOIN ", " _gf_files ${_gf_SOURCES})
    if(MSVC AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "GUI.Forms effects in ${target} (${_gf_files}) must be compiled with clang-cl "
                            "(LLVM 22), not cl.exe: only Clang can load the effect pass that bounds them. "
                            "Use the Visual Studio generator's ClangCL toolset (-T ClangCL) or set "
                            "CMAKE_CXX_COMPILER to clang-cl.")
    endif()
    if(GUIForms_EFFECTS_VERIFIED)
        return()
    endif()
    message(WARNING "GUI.Forms effects in ${target} (${_gf_files}) are unverified: the compiler is not "
                    "Clang 22 with the GUI.Forms plugin. They run, labelled unverified and counted by the "
                    "effect registry.")
    set_property(SOURCE ${_gf_SOURCES} TARGET_DIRECTORY ${target} APPEND PROPERTY
                 COMPILE_DEFINITIONS GUI_FORMS_EFFECTS_UNVERIFIED)
endfunction()

set(GUIForms_FONT_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/GUIForms/fonts")

# Components describe installed targets, not the producer's build options.
# Set these explicitly so REQUIRED COMPONENTS works and missing hosts fail here.
foreach(_gui_forms_component IN ITEMS Core Controls Drawing Threading Application Audio TextMasks AudioLoopTransport FreeType HarfBuzz CAbi CAbiConformance GalleryModel)
    if(TARGET GUIForms::${_gui_forms_component})
        set(GUIForms_${_gui_forms_component}_FOUND TRUE)
    else()
        set(GUIForms_${_gui_forms_component}_FOUND FALSE)
    endif()
endforeach()
foreach(_gui_forms_component IN LISTS GUIForms_FIND_COMPONENTS)
    if(NOT GUIForms_${_gui_forms_component}_FOUND)
        set(GUIForms_NOT_FOUND_MESSAGE
            "Requested GUIForms component '${_gui_forms_component}' is not installed. Core, Controls, Drawing and Threading are portable components. Application, CAbi and CAbiConformance require a supported native host build; Audio requires an audio-enabled build; TextMasks requires a native host build with GUI_FORMS_BUILD_TEXT_MASKS; AudioLoopTransport requires an audio build with GUI_FORMS_BUILD_AUDIO_LOOP_TRANSPORT; FreeType and HarfBuzz require a build with GUI_FORMS_INSTALL_TEXT_STACK; GalleryModel requires GUI_FORMS_INSTALL_GALLERY_MODEL (tools/build_sdk.py --features all builds all five).")
    endif()
endforeach()
unset(_gui_forms_component)
check_required_components(GUIForms)
