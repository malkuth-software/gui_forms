# Hostile-macro conformance of the consumer surface (tests/hostile_macros/;
# tools/consumer_macros.py says which names count), on both consumer paths:
# `import gui_forms;` (modules/gui_forms.cppm) and the headers inside the
# consumer-macro shield (gui_forms/gf_shield_begin.h and gf_shield_end.h,
# tools/consumer_shield.py). Each unit includes a header generated by
# tools/generate_hostile_macros.py, which includes the standard headers the
# consumer headers reach and then defines every identifier of their closure
# that a consumer may define as a macro that fails the compile where it
# expands; then it includes the consumer headers or imports the module. The
# unit compiles only if no consumer macro, known or not, reaches the surface.
#
# The objects are EXCLUDE_FROM_ALL until they have passed on every host:
#
#   cmake --build <tree> --target gui_forms_hostile_macro_conformance
#
# With GUI_FORMS_HOSTILE_MACRO_TESTS=ON each unit is also a ctest that builds
# its object. The report beside each generated header
# (<tree>/hostile_macros/hostile_macros_<set>.txt) lists every identifier with
# the header and line of its first use. The module unit exists when
# GUI_FORMS_BUILD_MODULE is ON (cmake/Module.cmake).
#
# Included from CMakeLists.txt inside the tests block, after gui_forms_core
# exists, with Python3_EXECUTABLE found.

set(GUI_FORMS_HOSTILE_MACRO_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/hostile_macros")
set(GUI_FORMS_HOSTILE_MACRO_NAMES "${CMAKE_CURRENT_SOURCE_DIR}/tests/hostile_macros/standard_library_names.txt")
# The include directories a consumer compiles with, transitively (STXlib's
# among them), one per line.
file(GENERATE OUTPUT "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/include_directories.txt"
    CONTENT "$<JOIN:$<TARGET_PROPERTY:gui_forms_core,INTERFACE_INCLUDE_DIRECTORIES>,\n>\n")
file(GLOB_RECURSE GUI_FORMS_HOSTILE_MACRO_HEADERS CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/include/gui_forms/*.h"
    "${CMAKE_CURRENT_SOURCE_DIR}/include/gui_forms/*.hpp")
add_custom_target(gui_forms_hostile_macro_conformance)

function(gui_forms_hostile_macro_flags target)
    if(CMAKE_C_COMPILER_ID MATCHES "Clang" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        # Every expansion reported, not the first twenty; a first-party
        # #define of an open name overrides the consumer's macro: an error.
        target_compile_options(${target} PRIVATE -ferror-limit=0 -Werror=macro-redefined)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PRIVATE -fmax-errors=0)
    endif()
    add_dependencies(gui_forms_hostile_macro_conformance ${target})
    if(GUI_FORMS_HOSTILE_MACRO_TESTS)
        add_test(NAME ${target}
            COMMAND ${CMAKE_COMMAND} --build "${CMAKE_BINARY_DIR}" --target ${target} --config $<CONFIG>)
    endif()
endfunction()

# gui_forms_add_hostile_macro_check(<set> <source> [LINK <target>] [SEEDS <header>...]):
# <source> includes "hostile_macros_<set>.h" and then the consumer headers of
# <set>; SEEDS adds seeds the unit does not include (the module's umbrellas).
function(gui_forms_add_hostile_macro_check set_name source)
    cmake_parse_arguments(PARSE_ARGV 2 check "" "LINK" "SEEDS")
    if(NOT check_LINK)
        set(check_LINK gui_forms_core)
    endif()
    set(seed_arguments)
    foreach(seed IN LISTS check_SEEDS)
        list(APPEND seed_arguments --seed "${seed}")
    endforeach()
    set(generated "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/hostile_macros_${set_name}.h")
    set(report "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/hostile_macros_${set_name}.txt")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/generate_hostile_macros.py"
            --translation-unit "${CMAKE_CURRENT_SOURCE_DIR}/${source}"
            --include-root "${CMAKE_CURRENT_SOURCE_DIR}/include"
            --include-directories-file "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/include_directories.txt"
            --surface "${CMAKE_CURRENT_SOURCE_DIR}/include/gui_forms"
            --standard-names "${GUI_FORMS_HOSTILE_MACRO_NAMES}"
            ${seed_arguments}
            --output "${generated}" --report "${report}"
        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tools/generate_hostile_macros.py"
            "${CMAKE_CURRENT_SOURCE_DIR}/tools/consumer_macros.py"
            "${GUI_FORMS_HOSTILE_MACRO_NAMES}" "${CMAKE_CURRENT_SOURCE_DIR}/${source}"
            ${GUI_FORMS_HOSTILE_MACRO_HEADERS}
        COMMENT "Generating hostile consumer macros for ${set_name}"
        VERBATIM)
    set(target gui_forms_hostile_macro_${set_name})
    add_library(${target} OBJECT EXCLUDE_FROM_ALL "${source}" "${generated}")
    target_include_directories(${target} PRIVATE "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}")
    # Usage requirements only (include directories, definitions, the module):
    # nothing links.
    target_link_libraries(${target} PRIVATE ${check_LINK})
    if(check_LINK STREQUAL "gui_forms_module")
        set_target_properties(${target} PROPERTIES CXX_SCAN_FOR_MODULES ON)
    endif()
    gui_forms_hostile_macro_flags(${target})
endfunction()

# The header path: the C ABI and the generated C++ binding open the shield
# themselves; the C++ units wrap their includes in it.
gui_forms_add_hostile_macro_check(c_abi tests/hostile_macros/hostile_macro_c_abi.c)
gui_forms_add_hostile_macro_check(cpp_binding tests/hostile_macros/hostile_macro_cpp_binding.cpp)
gui_forms_add_hostile_macro_check(minimal tests/hostile_macros/hostile_macro_minimal.cpp)
gui_forms_add_hostile_macro_check(platform_entries tests/hostile_macros/hostile_macro_platform_entries.cpp)
gui_forms_add_hostile_macro_check(umbrella tests/hostile_macros/hostile_macro_umbrella.cpp)
# The module path.
if(TARGET gui_forms_module)
    gui_forms_add_hostile_macro_check(module tests/hostile_macros/hostile_macro_module.cpp
        LINK gui_forms_module SEEDS gui_forms/gui_forms.hpp gui_forms/c/gf_abi.hpp)
endif()
# The shield restores the consumer's macros in nested, repeated and mixed
# include orders (a failed check is an #error).
add_library(gui_forms_shield_restore OBJECT EXCLUDE_FROM_ALL tests/hostile_macros/shield_restore.cpp)
target_link_libraries(gui_forms_shield_restore PRIVATE gui_forms_core)
gui_forms_hostile_macro_flags(gui_forms_shield_restore)

# The generated surface files are current: the shield's two headers (from
# every header under include/gui_forms) and the module interface unit.
# Regenerate with the _update targets.
add_test(NAME gui_forms_consumer_shield_check
    COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/consumer_shield.py" check
        --root "${CMAKE_CURRENT_SOURCE_DIR}"
        --include-directories-file "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/include_directories.txt")
add_test(NAME gui_forms_module_exports_check
    COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/module_exports.py" check
        --root "${CMAKE_CURRENT_SOURCE_DIR}")
add_custom_target(gui_forms_consumer_shield_update
    COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/consumer_shield.py" generate
        --root "${CMAKE_CURRENT_SOURCE_DIR}"
        --include-directories-file "${GUI_FORMS_HOSTILE_MACRO_DIRECTORY}/include_directories.txt"
    COMMAND ${Python3_EXECUTABLE} -B "${CMAKE_CURRENT_SOURCE_DIR}/tools/module_exports.py" generate
        --root "${CMAKE_CURRENT_SOURCE_DIR}"
    COMMENT "Regenerating the consumer-macro shield and the gui_forms module interface unit"
    VERBATIM)

# The generators themselves (pure Python, nothing compiled).
add_test(NAME gui_forms_consumer_macro_tools_unit
    COMMAND ${Python3_EXECUTABLE} -B -m unittest discover -s "${CMAKE_CURRENT_SOURCE_DIR}/tools"
        -p test_consumer_macros.py)
