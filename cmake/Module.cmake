# The gui_forms C++20 named module: `import gui_forms;`, the main consumer
# path (modules/gui_forms.cppm, generated by tools/module_exports.py). Its
# interface unit includes the consumer headers in its global module fragment
# and exports the consumer surface by name, so no macro of an importing unit
# reaches GUI.Forms' headers, and none of ours reaches the importer.
#
# Needs CMake 3.28 or later with Ninja (1.11+) or a Visual Studio generator,
# and a compiler CMake can scan: Clang 17+ (with clang-scan-deps beside it),
# GCC 14+ or MSVC 17.4+. A consumer's build compiles the installed interface
# unit with its own compiler and flags; the BMI itself is never installed.
#
# Included from CMakeLists.txt after the GUIFormsTargets export.
option(GUI_FORMS_BUILD_MODULE "Build and install the gui_forms C++20 module (import gui_forms;)" OFF)
if(NOT GUI_FORMS_BUILD_MODULE)
    return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.28)
    message(FATAL_ERROR "GUI_FORMS_BUILD_MODULE needs CMake 3.28 or later (this is ${CMAKE_VERSION})")
endif()
if(NOT CMAKE_GENERATOR MATCHES "Ninja|Visual Studio")
    message(FATAL_ERROR "GUI_FORMS_BUILD_MODULE needs a Ninja or Visual Studio generator, not ${CMAKE_GENERATOR}")
endif()

add_library(gui_forms_module STATIC)
target_sources(gui_forms_module
    PUBLIC FILE_SET CXX_MODULES
        BASE_DIRS "${CMAKE_CURRENT_SOURCE_DIR}/modules"
        FILES "${CMAKE_CURRENT_SOURCE_DIR}/modules/gui_forms.cppm")
target_link_libraries(gui_forms_module PUBLIC gui_forms_controls)
target_compile_features(gui_forms_module PUBLIC cxx_std_20)
set_target_properties(gui_forms_module PROPERTIES EXPORT_NAME Module CXX_SCAN_FOR_MODULES ON)
add_library(GUIForms::Module ALIAS gui_forms_module)
install(TARGETS gui_forms_module EXPORT GUIFormsModuleTargets
        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
        FILE_SET CXX_MODULES DESTINATION ${CMAKE_INSTALL_LIBDIR}/cxx/gui_forms)
install(EXPORT GUIFormsModuleTargets
        FILE GUIFormsModuleTargets.cmake
        NAMESPACE GUIForms::
        DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/GUIForms
        CXX_MODULES_DIRECTORY cxx/gui_forms)

