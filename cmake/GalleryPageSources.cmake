# Embeds the Gallery pages' sources for the page header's Source button
# (src/controls/gallery/page_sources.hpp): every page builder, the shared
# page parts, every page form document (the ui-templates screens included)
# and the window's own form pages, as byte arrays in one generated include.
# Run in script mode at build time:
#   cmake -DROOT=<source dir> -DOUTPUT=<include file> -P GalleryPageSources.cmake
# Bytes, not string literals: a source of any length or content embeds the
# same way on every compiler (MSVC caps a string literal at 64 KiB).
if(NOT ROOT OR NOT OUTPUT)
    message(FATAL_ERROR "GalleryPageSources.cmake needs ROOT and OUTPUT")
endif()
file(GLOB page_source_files RELATIVE "${ROOT}"
    "${ROOT}/src/controls/gallery/pages/*.cpp"
    "${ROOT}/src/controls/gallery/pages/demo_parts.hpp"
    "${ROOT}/demo/pages/*.form"
    "${ROOT}/demo/pages/templates/*.form"
    "${ROOT}/demo/gallery_form_pages.form")
list(SORT page_source_files)
list(LENGTH page_source_files page_source_count)
set(arrays "")
set(table "")
set(index 0)
foreach(path IN LISTS page_source_files)
    file(READ "${ROOT}/${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Sixteen bytes to a line.
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")
    # The array ends with a zero byte that `size` leaves out, so an empty
    # file still makes a valid array.
    string(APPEND arrays "inline constexpr unsigned char file_${index}[] = {\n${bytes}0x00};\n")
    string(APPEND table "    {\"${path}\", file_${index}, ${size}U},\n")
    math(EXPR index "${index} + 1")
endforeach()
set(content "// Generated by cmake/GalleryPageSources.cmake from the Gallery's page sources; do not edit.\n")
string(APPEND content "namespace gui_forms::gallery::page_sources {\n\n${arrays}\n")
string(APPEND content "inline constexpr std::array<EmbeddedSource, ${page_source_count}> embedded{{\n${table}}};\n\n")
string(APPEND content "} // namespace gui_forms::gallery::page_sources\n")
# Written only when it changed, so an unchanged page rebuilds nothing.
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
