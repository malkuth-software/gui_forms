<?xml version="1.0" encoding="UTF-8"?>
<!-- One button; owned_events.cpp attaches and revokes its handler. -->
<form xmlns="urn:gui-forms:form:1" id="example.window"
    text="Owned events"
    client-size="200 60">

  <panel id="example.root">
    <button id="example.run" text="Run" bounds="12 12 120 32"/>
  </panel>
</form>
