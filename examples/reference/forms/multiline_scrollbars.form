<?xml version="1.0" encoding="UTF-8"?>
<!-- A multiline text box that fills its window: its document extent decides
   which scroll bars it shows. -->
<form xmlns="urn:gui-forms:form:1" id="viewer.window"
    text="Document"
    client-size="360 240">

  <text-box id="viewer.document"
      multiline="true"
      auto-scroll="true"/>
</form>
