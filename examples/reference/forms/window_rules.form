<?xml version="1.0" encoding="UTF-8"?>
<!-- One button whose behaviour is a window rule (window_rules.cpp). -->
<form xmlns="urn:gui-forms:form:1" id="example.window"
    text="Window rules"
    client-size="320 200">

  <panel id="example.root">
    <button id="example.apply" text="Apply" bounds="12 12 100 32"/>
  </panel>
</form>
