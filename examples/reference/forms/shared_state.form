<?xml version="1.0" encoding="UTF-8"?>
<!-- A button that runs a model command and two sliders sharing one model
   value, all bound by the document as the window makes them. -->
<form xmlns="urn:gui-forms:form:1" id="shared.window"
    text="Shared state"
    client-size="360 160">

  <panel id="shared.root">
    <button id="run" text="Run" bounds="12 12 120 32" command="bind(run)"/>
    <track-bar id="volume.first" bounds="12 56 336 40" value="bind(volume)"/>
    <track-bar id="volume.second" bounds="12 104 336 40" value="bind(volume)"/>
  </panel>
</form>
