<?xml version="1.0" encoding="UTF-8"?>
<!-- The reference application's window: what exists and where it sits. Its
   behaviour is program code (collection_gallery.cpp) and its look is the
   program's theme package (themes/collection_gallery). A collection's items
   (the command bar's, the choices', the sections') are data, set by the
   program. -->
<form xmlns="urn:gui-forms:form:1" id="gallery.window"
    text="GUI.Forms - shared state and collections"
    client-size="760 610">

  <panel id="gallery">
    <command-bar id="commands" bounds="24 20 712 40"/>
    <track-bar id="volume.first" bounds="24 84 340 42">
      <bind property="value" to="volume"/>
    </track-bar>
    <track-bar id="volume.second" bounds="396 84 340 42">
      <bind property="value" to="volume"/>
    </track-bar>
    <check-box id="music.left" text="Music - shared command" bounds="24 150 340 36">
      <bind property="command" to="music"/>
    </check-box>
    <check-box id="music.right" text="Music - second presentation" bounds="396 150 340 36">
      <bind property="command" to="music"/>
    </check-box>
    <choice-group id="choices" bounds="24 220 712 52"/>
    <expandable-sections id="sections" bounds="24 300 712 220"/>
    <label id="status"
        text="Ready - arrows navigate groups; Tab leaves the command bar."
        bounds="24 540 712 44"
        classes="status"/>
  </panel>
</form>
