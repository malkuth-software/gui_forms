<?xml version="1.0" encoding="UTF-8"?>
<!-- Three buttons whose handlers carry bound values (bound_values.cpp). -->
<form xmlns="urn:gui-forms:form:1" id="settings.window"
    text="Bound values"
    client-size="360 60">

  <panel id="settings.root">
    <button id="back" text="Back" bounds="12 12 100 32"/>
    <button id="option" text="Option" bounds="124 12 100 32"/>
    <button id="tile" text="Tile" bounds="236 12 100 32"/>
  </panel>
</form>
