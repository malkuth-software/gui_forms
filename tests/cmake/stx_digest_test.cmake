# cmake/StxDigest.cmake: a file's digest does not depend on its line
# endings, an LF file's digest is its plain SHA-256, and different content
# still differs. Run with -DWORK_DIRECTORY=<scratch directory>.
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/StxDigest.cmake")
if(NOT WORK_DIRECTORY)
    message(FATAL_ERROR "stx digest test: WORK_DIRECTORY is not set")
endif()
file(MAKE_DIRECTORY "${WORK_DIRECTORY}")
set(_lf "${WORK_DIRECTORY}/lf.h")
set(_crlf "${WORK_DIRECTORY}/crlf.h")
set(_other "${WORK_DIRECTORY}/other.h")
# file(WRITE) writes in text mode (CRLF on Windows); file(CONFIGURE) writes
# the line endings asked for on every host.
file(CONFIGURE OUTPUT "${_lf}" CONTENT "#define ONE 1\n#define TWO 2\n" @ONLY NEWLINE_STYLE LF)
file(CONFIGURE OUTPUT "${_crlf}" CONTENT "#define ONE 1\n#define TWO 2\n" @ONLY NEWLINE_STYLE CRLF)
file(CONFIGURE OUTPUT "${_other}" CONTENT "#define ONE 1\n#define TWO 3\n" @ONLY NEWLINE_STYLE LF)
gui_forms_text_digest("${_lf}" _lf_digest)
gui_forms_text_digest("${_crlf}" _crlf_digest)
gui_forms_text_digest("${_other}" _other_digest)
file(SHA256 "${_lf}" _lf_raw)
file(SHA256 "${_crlf}" _crlf_raw)
if(_lf_raw STREQUAL _crlf_raw)
    message(FATAL_ERROR "stx digest test: the fixture files did not get different line endings")
endif()
if(NOT _lf_digest STREQUAL _crlf_digest)
    message(FATAL_ERROR "stx digest test: CRLF and LF copies differ (${_crlf_digest} vs ${_lf_digest})")
endif()
if(NOT _lf_digest STREQUAL _lf_raw)
    message(FATAL_ERROR "stx digest test: an LF file's digest is not its plain SHA-256")
endif()
if(_lf_digest STREQUAL _other_digest)
    message(FATAL_ERROR "stx digest test: different content has the same digest")
endif()
message(STATUS "stx digest test: passed")
