<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# class tables' ctest (part of gui_forms_abi_csharp): managed
       subclasses overriding the generated OnX hooks, against the built
       library. It references the source generator as an analyzer, as a
       program deriving from GuiForms.Forms classes does. A plain console
       program, so it builds offline from the SDK alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8981;IDE1006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../bindings/csharp/GuiForms.Forms/GuiForms.Forms.csproj" />
    <ProjectReference Include="../../../../bindings/csharp/GuiForms.Forms.Generators/GuiForms.Forms.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../../../../bindings/csharp/GuiForms.Interop/Generated/Aliases.g.cs" Link="Aliases.g.cs" />
  </ItemGroup>
</Project>
