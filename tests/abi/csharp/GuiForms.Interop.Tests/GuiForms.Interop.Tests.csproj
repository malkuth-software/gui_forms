<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# interop's ctest (gui_forms_abi_csharp): its layout against the
       manifest, negotiation, ownership, status translation and the callback
       thunks' shadow frames. A plain console program, so it builds offline
       from the SDK alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8981;IDE1006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../bindings/csharp/GuiForms.Interop/GuiForms.Interop.csproj" />
    <!-- The scalar aliases (gf_status, gf_object...) are per assembly. -->
    <Compile Include="../../../../bindings/csharp/GuiForms.Interop/Generated/Aliases.g.cs" Link="Aliases.g.cs" />
  </ItemGroup>
</Project>
