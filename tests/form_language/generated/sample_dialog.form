/* The form compiler's golden document (stage FD, phases FD5 and FD-6): a
   form root with the window's title, client size and buttons; nested
   controls; a component; bindings of Values (two way by the property's
   default, and narrowed to one way) and of Commands; values of several
   kinds (text items among them), and a title outside ASCII. */
form sample.dialog {
  text: "Réglages";
  client-size: 480 320;
  accept-button: "sample.ok";
  cancel-button: "sample.cancel";

  user-control sample.root {
    padding: 4 8;
    group-box sample.general {
      tab-index: 0;
      check-box sample.general.auto-save {
        text: "Save automatically";
        checked: bind(auto_save_);
        tab-index: 0;
      }
    }
    button sample.ok { text: "OK"; tab-index: 1; anchor: top right; command: bind(accept_); }
    button sample.cancel { text: "Cancel"; tab-index: 2; command: bind(dismiss_); }
    list-box sample.modes { items: "AM" "FM" "Wide FM"; tab-index: 3; }
    domain-up-down sample.band { items: "HF" "VHF" "UHF"; tab-index: 4; }
    label sample.heading { text: "Bands"; }
    numeric-up-down sample.level { value: bind(level_, one_way); tab-index: 5; }
  }
  command sample.save { }
}
