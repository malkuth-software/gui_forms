/* A settings dialog: properties, handler references, tab order and the
   classes its project theme styles (a form holds no style blocks). */
form settings.dialog {
  text: "Settings";
  size: 480 320;
  accept-button: settings.ok;
  cancel-button: settings.cancel;

  group settings.general {
    text: "General";
    tab-index: 0;
    check-box settings.general.autosave {
      text: "Save automatically";
      checked: true;
      tab-index: 0;
      on-checked-changed: autosave_changed;
    }
    text-box settings.general.name {
      text: "Untitled";
      tab-index: 1;
      on-text-changed: name_changed;
      classes: "field wide";
    }
  }

  button settings.ok {
    text: "OK";
    tab-index: 1;
    on-click: accept;
    classes: "default-action";
  }
  button settings.cancel { text: "Cancel"; tab-index: 2; on-click: dismiss; }
}
