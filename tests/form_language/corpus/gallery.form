<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="urn:gui-forms:form:1" id="gallery.root"
    title="GUI.Forms Gallery"
    min-size="1280 820">

  <!-- gallery.root is the declared boundary only. Its direct children are the
     mounts the registry-driven shell (src/controls/gallery_pages.cpp) places:
     the command strip across the top, one compiled-DML group per `page`, and
     the diagnostics overlay. Navigation is derived from manifests/controls.json. -->
  <command-strip id="gallery.command-strip"
      layout="flex-row">
    <button id="gallery.command.reset" text="Reset"/>
    <button id="gallery.command.diagnostics" text="Diagnostics" toggle="true"/>
    <label id="gallery.command.status" text="Portable core · Host 0.4 · drop-ready" flex="1"/>
  </command-strip>

  <backplane id="gallery.backplane"
      page="basics"
      material="gallery-fresco"
      size="660 200">
    <group id="gallery.basics-group"
        text="Basic controls"
        layout="form-grid">
      <label id="gallery.intro"
          text="Professional retained controls with deterministic native behavior."/>
      <text-input id="gallery.text-input"
          text="Edit this text"
          placeholder="Type here"/>
      <button id="gallery.default-button" text="Apply" default="true"/>
      <button id="gallery.disabled-button" text="Unavailable" enabled="false"/>
      <checkbox id="gallery.checkbox" text="Enable precise updates" checked="true"/>
      <radio id="gallery.radio.classic" text="Classic relief" group="gallery.style-mode" checked="true"/>
      <radio id="gallery.radio.quiet" text="Quiet relief" group="gallery.style-mode"/>
      <link-label id="gallery.link" text="Show control contract"/>
      <checkbox id="gallery.checkbox.indeterminate"
          text="Three-state option"
          three-state="true"
          state="indeterminate"/>
      <user-control id="gallery.lifecycle-card">
        <label id="gallery.lifecycle-title" text="COMPOSED"/>
        <label id="gallery.lifecycle-status" text="Awaiting attach"/>
      </user-control>
    </group>
  </backplane>

  <group id="gallery.values-group"
      page="values"
      text="Values and retained state"
      size="660 116">
    <slider id="gallery.slider" minimum="0" maximum="100" value="42"/>
    <progress id="gallery.progress" minimum="0" maximum="100" value="42"/>
    <label id="gallery.value-label" text="42%"/>
  </group>

  <group id="gallery.collection-group"
      page="retained-rows"
      text="Retained collection"
      size="660 144">
    <list id="gallery.collection">
      <row id="gallery.collection.alpha" text="Alpha channel" selected="true"/>
      <row id="gallery.collection.beta" text="Beta channel"/>
      <row id="gallery.collection.gamma" text="Gamma channel"/>
      <row id="gallery.collection.delta" text="Delta channel"/>
    </list>
  </group>

  <group id="gallery.instrument-group"
      page="instrument"
      text="Custom instrument"
      size="660 150">
    <instrument id="gallery.instrument" value="0.42"/>
  </group>

  <diagnostics id="gallery.diagnostics"
      text="Diagnostics"
      width="280"
      visible="false">
    <label id="gallery.diagnostics.about" text="GUI.Forms Gallery" wrap="true"/>
    <label id="gallery.diagnostics.renderer" text="renderer"/>
    <label id="gallery.diagnostics.controls" text="controls"/>
    <label id="gallery.diagnostics.layout" text="measure / arrange"/>
    <label id="gallery.diagnostics.paint" text="paint / damage"/>
    <label id="gallery.diagnostics.input" text="input / focus / activation"/>
    <label id="gallery.diagnostics.flush" text="wake / ticks / active"/>
    <label id="gallery.diagnostics.present" text="present / worst"/>
    <label id="gallery.diagnostics.font"
        text="Controls: Portsmouth Rapids 1.0; Fields: Carlito body specimen."/>
  </diagnostics>
</form>
