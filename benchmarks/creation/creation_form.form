<?xml version="1.0" encoding="UTF-8"?>
<!-- The creation-cost gate's form window (APP_WINDOW_RULES_DESIGN K.2): a
   settings dialog of 22 controls with handlers on its buttons, the shape of
   an ordinary application window. Change it only with a re-recorded
   baseline (creation_baseline.txt). -->
<form xmlns="urn:gui-forms:form:1" id="creation.settings"
    text="Settings"
    client-size="520 360"
    accept-button="creation.ok"
    cancel-button="creation.cancel">

  <user-control id="creation.root"
      padding="8 8">
    <group-box id="creation.general"
        text="General">
      <label id="creation.general.name-label" text="Name"/>
      <text-box id="creation.general.name" tab-index="0"/>
      <label id="creation.general.folder-label" text="Folder"/>
      <text-box id="creation.general.folder" tab-index="1"/>
      <check-box id="creation.general.auto-save" text="Save automatically" checked="true" tab-index="2"/>
      <check-box id="creation.general.backups" text="Keep backups" tab-index="3"/>
    </group-box>
    <group-box id="creation.view"
        text="View">
      <label id="creation.view.density-label" text="Density"/>
      <combo-box id="creation.view.density" items="Compact Comfortable Spacious" tab-index="4"/>
      <label id="creation.view.band-label" text="Band"/>
      <domain-up-down id="creation.view.band" items="HF VHF UHF" tab-index="5"/>
      <list-box id="creation.view.modes" items="AM FM 'Wide FM' USB LSB" tab-index="6"/>
    </group-box>
    <button id="creation.apply" text="Apply" tab-index="7"/>
    <button id="creation.reset" text="Reset" tab-index="8"/>
    <button id="creation.help" text="Help" tab-index="9"/>
    <button id="creation.ok" text="OK" tab-index="10"/>
    <button id="creation.cancel" text="Cancel" tab-index="11"/>
  </user-control>
</form>
