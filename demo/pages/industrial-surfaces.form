<?xml version="1.0" encoding="UTF-8"?>
<!-- The Gallery's industrial-surfaces page (skeudoindustrial surfaces,
   phase 5; notes:planning/SKEUDOINDUSTRIAL_SURFACES.md), rebuilt around
   the owner's process-control dialog (owner, 2026-11-22: "your lamps are
   not my lamps"; notes:experiments/industrial-surfaces/demo.html and the
   owner's reference render). gui_forms_add_form() compiles this document
   into industrial-surfaces_form.hpp at build time.

   gallery.industrial-surfaces.document is a declared boundary only: the
   page moves its children into the shell's page body (a 1000 x 660 design
   surface), where each is placed by its bounds in design coordinates.

   The dialog is the study's 500 x 310 body at the study's places: the
   blasted enamel and its heavier title band (the gallery theme's
   `blasted-enamel` classes, demo/themes/gallery/gallery.theme.css), the
   study's ivory type, the three status lamps as jewels through dots
   (centred 36 units in, 145, 174 and 203 down, 14 units across), and the
   CANCEL and OK keys lit from the shipped bakes (120 x 52.5 at 228 and
   360 across, 237.5 down). The page (src/controls/gallery/pages/
   industrial-surfaces.cpp) names each lamp's bake and colour and keeps
   the behaviour: the Lamps check box, the industrial theme check box,
   Start and Stop, and Coolant. A lamp is never clicked.

   Beside it, the industrial theme over the GOST paints on a few stock
   controls, with the lamp radio choice (indicator-style="lamp": the row
   takes the click, the jewel shows the choice) and the coolant flow
   pinpoint; below, the carbon fibre swatch. -->
<scaled-panel xmlns="urn:gui-forms:form:1" id="gallery.industrial-surfaces.document"
    design-size="1000 660">

  <label id="gallery.industrial-surfaces.heading"
      text="INDUSTRIAL SURFACES"
      classes="heading page-title"
      bounds="24 18 620 34"/>
  <label id="gallery.industrial-surfaces.lead"
      text="The owner's process-control dialog: blasted enamel, jewel status lamps and keys lit by baked light."
      classes="muted body"
      bounds="26 52 920 24"/>

  <panel id="gallery.industrial.dialog"
      classes="blasted-enamel"
      bounds="24 88 500 310">
    <panel id="gallery.industrial.dialog.title-band"
        classes="blasted-enamel-heavy"
        bounds="0 0 500 39"/>
    <label id="gallery.industrial.dialog.title"
        text="PROCESS CONTROL"
        classes="enamel-ink dialog-title"
        bounds="17 8 320 24"/>
    <label id="gallery.industrial.dialog.heading"
        text="START TRANSFER"
        classes="enamel-ink dialog-heading"
        bounds="24 62 440 30"/>
    <label id="gallery.industrial.dialog.subtitle"
        text="PUMP TO RESERVE TANK"
        classes="enamel-ink dialog-subtitle"
        bounds="24 95 440 18"/>
    <indicator-lamp id="gallery.industrial.status.pump-ready"
        text="PUMP READY"
        classes="enamel-ink"
        accessible-name="Pump ready"
        state="on"
        bounds="29 138 220 14"/>
    <indicator-lamp id="gallery.industrial.status.heating"
        text="HEATING"
        classes="enamel-ink"
        accessible-name="Heating"
        state="on"
        bounds="29 167 220 14"/>
    <indicator-lamp id="gallery.industrial.status.fault"
        text="FAULT"
        classes="enamel-ink"
        accessible-name="Fault"
        state="error"
        bounds="29 196 220 14"/>
    <indicator-lamp id="gallery.industrial.key.cancel"
        accessible-name="CANCEL key"
        state="on"
        bounds="228 237 120 53"/>
    <indicator-lamp id="gallery.industrial.key.ok"
        accessible-name="OK key"
        state="on"
        bounds="360 237 120 53"/>
  </panel>

  <scaled-group-box id="gallery.industrial.preview"
      text="Industrial theme · GOST machine-tool paints"
      classes="paper group-caption"
      design-size="436 310"
      bounds="540 88 436 310">
    <check-box id="gallery.industrial.theme"
        text="The industrial theme on this group"
        bounds="16 36 320 24"/>
    <button id="gallery.industrial.preview.start"
        text="Start"
        bounds="16 72 110 30"/>
    <button id="gallery.industrial.preview.stop"
        text="Stop"
        bounds="136 72 110 30"/>
    <button id="gallery.industrial.preview.erase"
        text="Erase program"
        danger="true"
        bounds="256 72 164 30"/>
    <check-box id="gallery.industrial.preview.coolant"
        text="Coolant"
        checked="true"
        bounds="16 116 200 24"/>
    <indicator-lamp id="gallery.industrial.preview.running"
        text="Running"
        bounds="256 116 164 24"/>
    <radio-button id="gallery.industrial.preview.manual"
        text="Manual feed"
        group-name="gallery-industrial-feed"
        indicator-style="lamp"
        checked="true"
        bounds="16 148 200 24"/>
    <indicator-lamp id="gallery.industrial.preview.fault"
        text="Fault"
        state="error"
        bounds="256 148 164 24"/>
    <radio-button id="gallery.industrial.preview.automatic"
        text="Automatic feed"
        group-name="gallery-industrial-feed"
        indicator-style="lamp"
        bounds="16 180 200 24"/>
    <indicator-lamp id="gallery.industrial.preview.coolant-lamp"
        text="Coolant flow"
        state="on"
        lamp-style="pinpoint"
        bounds="256 180 164 24"/>
    <label id="gallery.industrial.preview.state"
        text=""
        classes="muted note"
        bounds="16 216 404 80"/>
  </scaled-group-box>

  <scaled-group-box id="gallery.industrial.carbon"
      text="Carbon fibre · a seeded twill that tiles"
      classes="paper group-caption"
      design-size="500 238"
      bounds="24 410 500 238">
    <panel id="gallery.industrial.pattern.carbon-fibre"
        classes="pattern-carbon-fibre"
        bounds="16 36 240 150"/>
    <label id="gallery.industrial.pattern.carbon-fibre.caption"
        text="Fine strands in each tow, and a sparse glint where a tow floats over."
        classes="muted note"
        bounds="272 36 200 150"/>
  </scaled-group-box>

  <scaled-group-box id="gallery.industrial.lamps-group"
      text="Lamps · lit from baked light, never clicked"
      classes="paper group-caption"
      design-size="436 238"
      bounds="540 410 436 238">
    <check-box id="gallery.industrial.lamps"
        text="Lamps on"
        indicator-style="toggle"
        checked="true"
        bounds="16 36 200 24"/>
    <label id="gallery.industrial.lamps.note"
        text="The check box switches the dialog's status lamps and its OK key; CANCEL stays lit. The bakes ship with the library."
        classes="muted note"
        bounds="16 72 404 60"/>
  </scaled-group-box>
</scaled-panel>
