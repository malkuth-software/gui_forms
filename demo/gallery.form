<?xml version="1.0" encoding="UTF-8"?>
<!-- The Gallery's window (stage B: the window is the form). The build
   generates gui_forms::gallery::GalleryWindow, a gui_forms::Window, from
   this document with gui_forms_add_form MODEL GalleryModel
   (demo/gallery_model.hpp): its objects are the window's members, and its
   bindings read the model's Values (FD-6).

   gallery.shell is laid out as a Windows Forms window is (owner,
   2026-11-08): the command strip docked top, the navigation docked left,
   the status strip docked bottom beside it, the diagnostics docked right
   while shown, and the page area filling the rest. The bounds are the
   default window's, against which the anchored children keep their
   distances. The program fills the navigation and the page area from the
   page list (src/controls/gallery_pages.cpp).

   The Gallery's own pages are demo/gallery_form_pages.form, made apart
   from the window so each control is attached once, in its page body.

   The form names no program code (owner ruling FD-6 R6): the program arms
   one window rule per interaction the Gallery answers (GalleryContext::
   attach, src/controls/gallery_controls.cpp).

   -->
<form xmlns="urn:gui-forms:form:1" id="gallery.window"
    text="GUI.Forms Gallery"
    client-size="1280 820">

  <panel id="gallery.shell"
      classes="shell-canvas"
      bounds="0 0 1280 820">

    <panel id="gallery.command-strip"
        bounds="0 0 1280 34"
        dock="top">
      <button id="gallery.command.reset"
          text="Reset"
          bounds="6 5 72 24"/>
      <button id="gallery.command.diagnostics"
          text="Diagnostics"
          bounds="84 5 96 24"/>
      <picture-box id="gallery.command.status-badge" accessible-name="Host status" bounds="188 9 16 16"/>
      <label id="gallery.command.status"
          text="Portable core · drop-ready"
          classes="control-body"
          bounds="210 5 1064 24"/>
    </panel>
    <!-- The navigation lists every page, more than fit in one column, so it
       scrolls; the program adds the rows above the paper. -->
    <scrollable-control id="gallery.sidebar"
        bounds="0 34 238 786"
        dock="left"
        auto-scroll="true">
      <panel id="gallery.sidebar.paper" classes="navigation-paper" bounds="0 0 206 786"/>
    </scrollable-control>
    <!-- Before the page area, so it claims its edge first. -->
    <panel id="gallery.status"
        classes="status-strip"
        bounds="238 776 1042 44"
        dock="bottom">
      <panel id="gallery.status.rule" classes="rule-line" bounds="0 0 1042 1" dock="top"/>
      <label id="gallery.status.text" bounds="18 10 800 24" anchor="top left right"/>
      <check-box id="gallery.status.live"
          text="Live animation"
          indicator-style="toggle"
          bounds="846 8 180 28"
          anchor="top right">
        <bind property="checked" to="live_motion"/>
      </check-box>
    </panel>

    <group-box id="gallery.diagnostics"
        text="Diagnostics"
        bounds="1000 34 280 742"
        dock="right">
      <bind property="visible" to="diagnostics_visible" mode="one-way"/>
      <label id="gallery.diagnostics.about" text="GUI.Forms Gallery" classes="note" bounds="10 22 260 52"/>
      <label id="gallery.diagnostics.renderer" text="renderer" classes="body" bounds="10 80 260 20"/>
      <label id="gallery.diagnostics.controls" text="controls" classes="body" bounds="10 106 260 20"/>
      <label id="gallery.diagnostics.layout" text="measure / arrange" classes="body" bounds="10 132 260 20"/>
      <label id="gallery.diagnostics.paint" text="paint / damage" classes="body" bounds="10 158 260 20"/>
      <label id="gallery.diagnostics.input" text="input / focus / activation" classes="body" bounds="10 184 260 20"/>
      <label id="gallery.diagnostics.flush" text="wake / ticks / active" classes="body" bounds="10 210 260 20"/>
      <label id="gallery.diagnostics.present" text="present / worst" classes="body" bounds="10 236 260 20"/>
      <label id="gallery.diagnostics.font"
          text="Controls: Portsmouth Rapids 1.0; Fields: Carlito body specimen."
          classes="note"
          bounds="10 262 260 52"/>
      <!-- The invalidation overlay (docs/user/debugging.md): outlines what
         the window presents again, for 300 ms, by cause. -->
      <check-box id="gallery.diagnostics.invalidation"
          text="Show invalidation"
          bounds="10 320 260 28"/>
    </group-box>
    <!-- Each page's viewport goes here, anchored to all four edges. -->
    <panel id="gallery.content"
        classes="shell-canvas"
        bounds="238 34 1042 742"
        dock="fill"/>
  </panel>
</form>
