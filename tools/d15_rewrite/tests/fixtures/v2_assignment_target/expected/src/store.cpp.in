#include <gui_forms/store.hpp>

#include <stxlib/text_view.hpp>
#include <optional>
#include <string>
#include <string_view>
#include <variant>
#include "platform/stxlib_bridge.hpp"

namespace gui_forms {

namespace {

std::variant<std::monostate, bool, std::string> stored;
std::optional<std::string> kept;
std::string_view seen;

} // namespace

// The assignment operator's parameter picks the bridge: a variant's and an
// optional's converting operator= take the std::string, a view's a view.
void store(stxlib::TextView text) {
    stored = gui_forms::platform::standard_text_copy(text);
    kept = gui_forms::platform::standard_text_copy(text);
    seen = gui_forms::platform::standard_text(text);
}

} // namespace gui_forms
