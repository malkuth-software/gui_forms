#include <gui_forms/bytes.hpp>

int main() {
    const std::size_t invalid = gui_forms::count_bytes("\xc3\x28");
    const std::size_t joined = gui_forms::count_bytes("a\xFF\xC3" "b");
    const std::size_t named = gui_forms::name_length("na\xC3\xAFve");
    return invalid + joined + named == 12U && !gui_forms::is_marker("ok") ? 0 : 1;
}
