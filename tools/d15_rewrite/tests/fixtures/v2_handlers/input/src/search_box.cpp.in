#include <gui_forms/search_box.hpp>

#include <string>
#include <string_view>

namespace gui_forms {

void SearchBox::attach() {
    const Delegate committed = Delegate::bind<SearchBox, &SearchBox::editor_committed>(*this);
    static_cast<void>(committed);
    const CancelHandler cancelled = &SearchBox::editor_cancelled;
    ((*this).*cancelled)("stop");
    const ChangeCallback callback{this};
    callback("go");
    editor_changed("go");
}

void SearchBox::editor_committed(const std::string& text) {
    last_ = text;
}

void SearchBox::editor_cancelled(const std::string& text) {
    last_ = text;
}

void SearchBox::editor_changed(const std::string_view text) {
    last_ = std::string(text);
}

void SearchBox::ChangeCallback::operator()(const std::string& text) const {
    (*owner).editor_committed(text);
}

} // namespace gui_forms
