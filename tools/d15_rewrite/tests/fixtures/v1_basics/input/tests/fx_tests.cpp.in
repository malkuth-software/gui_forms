#include <gui_forms/fx.hpp>

#include <optional>

namespace {

[[nodiscard]] bool check(const std::optional<gui_forms::Color>& expected, const gui_forms::Box& box) {
    return box.fill() == expected;
}

} // namespace

int main() {
    gui_forms::Box box;
    box.set_fill(gui_forms::Color{3U});
    box.set_fill(std::nullopt);
    box.set_fill({});
    gui_forms::Style style;
    style.fill = gui_forms::Color{4U};
    style.index = 2U;
    style.index = std::nullopt;
    if (!style.fill.has_value()) return 1;
    if (style.fill) style.index.reset();
    if (!style.fill) return 2;
    const unsigned direct = style.fill->value;
    const unsigned star = (*style.fill).value;
    const unsigned checked = style.fill.value().value;
    const bool same = style.fill == gui_forms::Color{4U};
    const bool absent = style.index == std::nullopt;
    const unsigned taken = box.fill().value().value;
    const unsigned taken_star = (*box.fill()).value;
    const std::optional<gui_forms::Color> local = box.fill();
    const bool local_present = local.has_value();
    const bool helper = check(style.fill, box);
    const unsigned flags = (same ? 1U : 0U) + (absent ? 1U : 0U) + (local_present ? 1U : 0U) + (helper ? 1U : 0U);
    return direct + star + checked + taken + taken_star + flags == 0U ? 0 : 3;
}
