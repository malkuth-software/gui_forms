#include <gui_forms/api.hpp>
#include <gui_forms/internal.hpp>

#include <optional>

namespace gui_forms {

std::optional<int> read_limit(const Api& api) noexcept {
    Cache cache;
    store(cache, api.limit);
    const std::optional<int> local = api.limit;
    cache.cached = local;
    return local;
}

void store(Cache& cache, const std::optional<int> value) noexcept {
    cache.cached = value;
}

} // namespace gui_forms
