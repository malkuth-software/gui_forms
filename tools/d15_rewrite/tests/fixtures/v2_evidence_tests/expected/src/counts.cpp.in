#include <gui_forms/counts.hpp>

#include <stxlib/text_view.hpp>
#include <cstddef>
#include <string_view>

namespace gui_forms {

std::size_t count_bytes(const std::string_view bytes) {
    return bytes.size();
}

std::size_t count_chars(const std::string_view text) {
    return text.size();
}

std::size_t name_length(const stxlib::TextView name) {
    return name.count();
}

} // namespace gui_forms
