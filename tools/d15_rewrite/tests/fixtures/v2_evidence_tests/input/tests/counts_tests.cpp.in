#include <gui_forms/counts.hpp>

#include <string>

int main() {
    const std::string owned = "abc";
    const std::size_t invalid = gui_forms::count_bytes("\xc3\x28");
    const std::size_t chars = gui_forms::count_chars(owned);
    const std::size_t named = gui_forms::name_length("na\xC3\xAFve");
    return invalid + chars + named == 11U ? 0 : 1;
}
