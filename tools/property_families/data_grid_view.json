  "not_properties": [
    {
      "name": "allow_user_to_add_rows",
      "reason": "written needs the current position from before the store (the new row leaves); a compound capability later"
    },
    {
      "name": "first_displayed_row, horizontal_scroll_offset",
      "reason": "view positions the grid's scrolling moves (a view capability, as ScrollableControl's auto_scroll_position, later)"
    },
    {
      "name": "columns, rows, row_count, data_source, virtual rows and their per-column and per-row setters",
      "reason": "collections and indexed values, not single properties (the in-place collections proposal)"
    }
  ],
