      "clear": null,
      "field": "decimal_places_",
      "event": null,
      "on_changed": false,
      "localizable": null,
      "hooks": "generated",
      "table": {
        "kind": "unsigned_integer",
        "category": "Appearance",
        "description": "Digits after the decimal point in the shown value.",
        "default": "BindingValue{std::uint64_t{0U}}",
        "effects": "Dirty::measure | Dirty::arrange | Dirty::paint | Dirty::semantics",
        "subtree": false,
        "bindable": false,
        "browsable": true,
        "nullable": false,
        "enumeration": null,
        "reset": null,
        "registry": false
      },
      "prepare": [
        "if (incoming > 6U) throw std::invalid_argument(\"gauge decimal places must be at most 6\");"
      ],
      "sample": "std::uint32_t{1U}"
