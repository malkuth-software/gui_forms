    {
      "name": "tick_frequency",
      "capability": "GaugeBaseTickFrequency",
      "value": "double",
      "initial": "10.0",
      "comment": "Distance in value units between scale marks; zero draws none. Negative or not finite throws std::invalid_argument.",
      "getter": "tick_frequency",
      "setter": "set_tick_frequency",
      "clear": null,
      "field": "tick_frequency_",
      "event": null,
      "on_changed": false,
      "localizable": null,
      "hooks": "generated",
      "table": {
        "kind": "number",
        "category": "Appearance",
        "description": "Distance in value units between scale marks.",
        "default": "BindingValue{10.0}",
        "effects": "Dirty::paint",
        "subtree": false,
        "bindable": true,
        "browsable": true,
        "nullable": false,
        "enumeration": null,
        "reset": null,
        "registry": false
      },
      "prepare": [
        "if (!std::isfinite(incoming) || incoming < 0.0) throw std::invalid_argument(\"gauge tick frequency must be finite and not negative\");"
      ],
      "sample": "5.0"
    },
    {
      "name": "units",
      "capability": "GaugeBaseUnits",
      "value": "std::string",
      "initial": null,
      "comment": "The unit shown after the value, such as \"kPa\"; empty for none. Must be valid UTF-8 (std::invalid_argument).",
      "getter": "units",
      "setter": "set_units",
      "clear": null,
      "field": "units_",
      "event": null,
      "on_changed": false,
      "localizable": "units",
      "hooks": "generated",
      "table": {
        "kind": "text",
        "category": "Appearance",
        "description": "The unit shown after the value.",
        "default": "BindingValue{std::string{}}",
        "effects": "Dirty::measure | Dirty::arrange | Dirty::paint | Dirty::semantics",
        "subtree": false,
        "bindable": false,
        "browsable": true,
        "nullable": false,
        "enumeration": null,
        "reset": null,
        "registry": false
      },
      "prepare": [
        "if (!validate_utf8(incoming).valid()) throw std::invalid_argument(\"gauge units must be valid UTF-8\");"
      ],
      "sample": "std::string{\"kPa\"}"
    },
    {
      "name": "decimal_places",
      "capability": "GaugeBaseDecimalPlaces",
