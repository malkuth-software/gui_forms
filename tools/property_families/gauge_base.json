    {
      "name": "high_alarm",
      "capability": "GaugeBaseHighAlarm",
      "value": "std::optional<double>",
      "initial": null,
      "comment": "The value above which the gauge is in alarm, or none. A present value that is not finite throws std::invalid_argument.",
      "getter": "high_alarm",
