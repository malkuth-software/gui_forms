{
  "schema": "gui.forms.abi.compat-map/v1",
  "notes": [
    "The Windows Forms facade (generated/facade-v1) reaches native code only through the 0.x table gf_api_v0 and the gf_windows_paint_endpoint_*_v1 exports (include/gui_forms/c_api.h).",
    "Every row of the facade's required member set resolves through them, so the C5 gate maps each of them to a stable ABI slot, schema property or interaction.",
    "A target is slot:<table>.<slot>, property:<schema property> or interaction:<schema interaction>; pending names the C5d family that will carry it; deferred states why it is not carried."
  ],
  "entries": [
    {"v0": "last_error", "targets": ["slot:runtime.error_detail"]},
    {"v0": "control_create", "targets": ["slot:objects.create"]},
    {"v0": "retain", "targets": ["slot:objects.retain"]},
    {"v0": "release", "targets": ["slot:objects.release"]},
    {"v0": "dispose", "targets": ["slot:objects.dispose"]},
    {"v0": "component_state", "targets": ["slot:objects.state"]},
    {"v0": "stable_id", "targets": ["slot:objects.stable_id"]},
    {"v0": "set_visible", "targets": ["slot:properties.set", "property:visible"]},
    {"v0": "get_visible", "targets": ["slot:properties.get", "property:visible"]},
    {"v0": "set_bounds", "targets": ["slot:properties.set", "property:bounds"]},
    {"v0": "get_bounds", "targets": ["slot:properties.get", "property:bounds"]},
    {"v0": "add_child", "targets": ["slot:objects.insert_child"]},
    {"v0": "remove_child", "targets": ["slot:objects.remove_child"]},
    {"v0": "subscribe", "targets": ["slot:events.subscribe"]},
    {"v0": "disconnect", "targets": ["slot:events.disconnect"]},
    {"v0": "control_create_kind", "targets": ["slot:objects.create"]},
    {"v0": "set_name", "targets": ["slot:properties.set", "property:name"]},
    {"v0": "get_name", "targets": ["slot:properties.get", "property:name"]},
    {"v0": "set_text", "targets": ["slot:properties.set", "property:text"]},
    {"v0": "get_text", "targets": ["slot:properties.get", "property:text"]},
    {"v0": "set_enabled", "targets": ["slot:properties.set", "property:enabled"]},
    {"v0": "get_enabled", "targets": ["slot:properties.get", "property:enabled"]},
    {"v0": "run_window", "targets": ["slot:windows.run"]},
    {"v0": "last_host_trace", "deferred": "a 0.x test aid with no C++ counterpart; the shadow frames and structured counters are the 1.0 diagnostics"},
    {"v0": "subscribe_v2", "targets": ["slot:events.subscribe"]},
    {"v0": "begin_invoke", "targets": ["slot:dispatch.begin_invoke"]},
    {"v0": "request_close", "targets": ["slot:windows.request_close"]},
    {"v0": "callback_fault_count", "deferred": "1.0 callbacks return no failure (the no-unwind rule), so there is no fault to count"},
    {"v0": "set_control_png", "targets": ["slot:themes.load_image", "slot:properties.set", "property:image"], "note": "a picture box shows the image"},
    {"v0": "set_child_index", "targets": ["slot:objects.remove_child", "slot:objects.insert_child"], "note": "a move is a removal and an insertion at the index"},
    {"v0": "set_control_colors", "targets": ["slot:properties.set", "property:back_color", "property:fore_color"], "note": "Control's own background and text colours; null clears them"},
    {"v0": "subscribe_pointer", "targets": ["slot:events.subscribe"]},
    {"v0": "set_check_state", "targets": ["slot:properties.set", "property:check_state"], "note": "a radio button's state is its checked property"},
    {"v0": "get_check_state", "targets": ["slot:properties.get", "property:check_state"]},
    {"v0": "subscribe_key", "targets": ["slot:events.subscribe"]},
    {"v0": "subscribe_text", "targets": ["slot:events.subscribe"]},
    {"v0": "set_range", "targets": ["slot:properties.set", "property:minimum", "property:maximum"]},
    {"v0": "get_range", "targets": ["slot:properties.get", "property:minimum", "property:maximum"]},
    {"v0": "set_range_value", "targets": ["slot:properties.set", "property:value"]},
    {"v0": "get_range_value", "targets": ["slot:properties.get", "property:value"]},
    {"v0": "set_pointer_capture", "targets": ["slot:controls.set_pointer_capture"]},
    {"v0": "get_pointer_capture", "targets": ["slot:controls.pointer_capture"]},
    {"v0": "show_path_dialog", "targets": ["slot:host.show_dialog"]},
    {"v0": "last_dialog_path", "targets": ["slot:host.dialog_path_at"]},
    {"v0": "show_tooltip", "targets": ["slot:overlays.set_tool_tip", "slot:overlays.show_tool_tip"], "note": "through a tool_tip component bound to the window"},
    {"v0": "hide_tooltip", "targets": ["slot:overlays.hide_tool_tip"]},
    {"v0": "set_field_selection", "targets": ["slot:text_editing.select"], "note": "the caret's visibility is the text box's own"},
    {"v0": "set_field_edit_state", "targets": ["slot:text_editing.select"], "note": "the caret's visibility is the text box's own"},
    {"v0": "field_position_from_point", "deferred": "TextBox has no public hit test in C++; the box handles pointer input itself"},
    {"v0": "write_clipboard_text", "targets": ["slot:host.write_clipboard_text"]},
    {"v0": "read_clipboard_text", "targets": ["slot:host.read_clipboard_text"]},
    {"v0": "field_navigate", "targets": ["slot:text_editing.grapheme_boundary"]},
    {"v0": "field_replace", "targets": ["slot:text_editing.replace_range"]},
    {"v0": "field_history", "targets": ["slot:text_editing.undo", "slot:text_editing.redo"]},
    {"v0": "field_clear_history", "targets": ["slot:text_editing.clear_undo_history"]},
    {"v0": "set_control_pixels", "targets": ["slot:themes.load_pixels", "slot:properties.set", "property:image"], "note": "a picture box shows the pixels"},
    {"v0": "get_control_absolute_bounds", "targets": ["slot:controls.window_bounds"]},
    {"v0": "subscribe_key_preview", "targets": ["slot:events.subscribe"]},
    {"v0": "set_cursor", "targets": ["slot:properties.set", "property:cursor"]},
    {"v0": "get_cursor", "targets": ["slot:properties.get", "property:cursor"]},
    {"v0": "set_auto_scroll_offset", "targets": ["slot:properties.set", "property:auto_scroll_offset"]},
    {"v0": "set_auto_scroll", "targets": ["slot:properties.set", "property:auto_scroll"]},
    {"v0": "set_auto_scroll_margin", "targets": ["slot:properties.set", "property:auto_scroll_margin"]},
    {"v0": "set_auto_scroll_min_size", "targets": ["slot:properties.set", "property:auto_scroll_min_size"]},
    {"v0": "set_auto_scroll_position", "targets": ["slot:properties.set", "property:auto_scroll_position"]},
    {"v0": "get_scroll_state", "targets": ["slot:controls.scroll_state"]},
    {"v0": "set_scroll_axis_state", "targets": ["slot:controls.set_scroll_axis"]},
    {"v0": "scroll_control_into_view", "targets": ["slot:controls.scroll_into_view"]},
    {"v0": "suspend_layout", "targets": ["slot:controls.suspend_layout"]},
    {"v0": "resume_layout", "targets": ["slot:controls.resume_layout"]},
    {"v0": "perform_control_layout", "targets": ["slot:controls.perform_layout"]},
    {"v0": "get_layout_state", "targets": ["slot:controls.layout_state"]},
    {"v0": "property_grid_set_selected_controls", "targets": ["slot:property_grid.select_objects"]},
    {"v0": "property_grid_set_sort", "targets": ["slot:properties.set", "property:property_sort"]},
    {"v0": "property_grid_get_sort", "targets": ["slot:properties.get", "property:property_sort"]},
    {"v0": "property_grid_refresh", "targets": ["slot:property_grid.refresh"]},
    {"v0": "property_object_define", "targets": ["slot:custom_controls.create"], "note": "the properties are declared with the custom control, as a C++ subclass declares its own"},
    {"v0": "property_object_notify_changed", "targets": ["slot:custom_controls.notify_changed"]},
    {"v0": "property_grid_try_set_text", "targets": ["slot:property_grid.try_set_text"]},
    {"v0": "property_grid_reset_property", "targets": ["slot:property_grid.reset_property"]},
    {"v0": "property_grid_activate_editor", "targets": ["slot:property_grid.activate_editor"]},
    {"v0": "set_control_text_alignment", "targets": ["slot:properties.set", "property:text_alignment", "property:alignment", "property:vertical_alignment"], "note": "a button's content alignment; a label's horizontal and vertical alignment"},
    {"v0": "set_button_appearance", "targets": ["slot:properties.set", "property:visual_style", "property:flat_border_width"]},
    {"v0": "set_panel_border_style", "targets": ["slot:properties.set", "property:border_style"]},
    {"v0": "attach_overlay", "targets": ["slot:overlays.open_overlay"]},
    {"v0": "detach_overlay", "targets": ["slot:overlays.close_overlay"]},
    {"v0": "gf_windows_paint_endpoint_acquire_v1", "targets": ["slot:windows_paint_endpoint.acquire"], "note": "binds a custom control, which shows the endpoint's frames in place of its paint callback"},
    {"v0": "gf_windows_paint_endpoint_configure_v1", "targets": ["slot:windows_paint_endpoint.configure"]},
    {"v0": "gf_windows_paint_endpoint_touch_v1", "targets": ["slot:windows_paint_endpoint.touch"]},
    {"v0": "gf_windows_paint_endpoint_drain_v1", "targets": ["slot:windows_paint_endpoint.drain"]},
    {"v0": "gf_windows_paint_endpoint_snapshot_v1", "targets": ["slot:windows_paint_endpoint.snapshot"]},
    {"v0": "gf_windows_paint_endpoint_release_v1", "targets": ["slot:windows_paint_endpoint.release"]},
    {"v0": "gf_windows_paint_endpoint_submit_bgra_v1", "targets": ["slot:windows_paint_endpoint.submit_bgra"]},
    {"v0": "gf_windows_paint_endpoint_get_dc_v1", "targets": ["slot:windows_paint_endpoint.get_dc"]},
    {"v0": "gf_windows_paint_endpoint_release_dc_v1", "targets": ["slot:windows_paint_endpoint.release_dc"]},
    {"v0": "gf_windows_paint_endpoint_publish_dc_v1", "targets": ["slot:windows_paint_endpoint.publish_dc"]},
    {"v0": "gf_windows_paint_endpoint_begin_write_v1", "targets": ["slot:windows_paint_endpoint.begin_write"]},
    {"v0": "gf_windows_paint_endpoint_end_write_v1", "targets": ["slot:windows_paint_endpoint.end_write"]}
  ]
}
